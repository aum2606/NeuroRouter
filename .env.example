# Copy this file to .env. Never commit real credentials.
TYPESAFE_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional runtime overrides use Pydantic's nested delimiter.
# Example: NEUROROUTER_TELEMETRY__DATABASE_PATH=data/custom.db
NEUROROUTER_APP__ENVIRONMENT=development
NEUROROUTER_APP__LOG_LEVEL=INFO

# Keep mock for no-key local development. Supported future values:
# mock, groq, gemini, openrouter
NEUROROUTER_LLM__PROVIDER=mock
